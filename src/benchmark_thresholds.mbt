///|
pub fn benchmark_threshold_count() -> Int {
  benchmark_thresholds().length()
}

///|
pub fn benchmark_max_input_size() -> Int {
  let mut result = 0
  for item in benchmark_thresholds() {
    if item.input_size > result {
      result = item.input_size
    }
  }
  result
}
